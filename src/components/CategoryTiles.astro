---
// Homepage "Pick your poison" break: one photo tile per category, linking to
// that category's page. Cover is the newest post in the category.
import { TAG_DEFS } from "../data/tags";
import type { Post } from "../lib/utils";
import { cardMediaSrc } from "../lib/utils";

interface Props {
  posts: Post[]; // already sorted newest first
  avoid?: string[]; // slugs not to use as covers (e.g. already shown above)
}
const { posts, avoid = [] } = Astro.props;

const used = new Set(avoid);
const tiles = TAG_DEFS.map((d) => {
  const inCat = posts.filter((p) => p.data.tags.includes(d.tag) && cardMediaSrc(p));
  // Prefer a cover no other tile (or the strip above) is already using.
  const cover = inCat.find((p) => !used.has(p.data.slug)) ?? inCat[0];
  if (cover) used.add(cover.data.slug);
  return { d, n: inCat.length, src: cover && cardMediaSrc(cover) };
})
  .filter((t) => t.n > 0 && t.src)
  .sort((a, b) => b.n - a.n);
---
<section class="cat-tiles" aria-labelledby="catTilesHeading" data-reveal>
  <div class="cat-tiles-head">
    <span class="eyebrow">Browse by style</span>
    <h2 id="catTilesHeading">Pick Your Poison</h2>
  </div>
  <div class="cat-tiles-grid">
    {tiles.map(({ d, n, src }) => (
      <a class="cat-tile" href={`/tag/${d.slug}`}>
        <img src={src} alt="" loading="lazy" />
        <span class="cat-tile-label">
          <span class="cat-tile-name">{d.label}</span>
          <span class="cat-tile-count">{n} houses &rarr;</span>
        </span>
      </a>
    ))}
  </div>
</section>
