---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const id = "circlePath-" + Math.random().toString(36).slice(2, 9);
---
<svg viewBox="0 0 120 120" class={`stamp ${className ?? ""}`} aria-hidden="true">
  <defs>
    <path id={id} d="M 60,60 m -43,0 a 43,43 0 1,1 86,0 a 43,43 0 1,1 -86,0" />
  </defs>
  <circle cx="60" cy="60" r="52" fill="none" stroke="currentColor" stroke-width="1.5" />
  <circle cx="60" cy="60" r="33" fill="none" stroke="currentColor" stroke-width="1.2" />
  <text font-family="Space Mono, monospace" font-size="8.6" letter-spacing="2.6" fill="currentColor">
    <textPath href={`#${id}`} startOffset="0%">MADE THE P LIST &bull; MADE THE P LIST &bull; </textPath>
  </text>
  <text x="60" y="68" text-anchor="middle" font-family="Big Shoulders Display, sans-serif" font-size="30" font-weight="900" fill="currentColor">P</text>
</svg>
