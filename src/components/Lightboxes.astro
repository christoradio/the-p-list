---
---
<div class="lightbox" id="lightbox" aria-hidden="true">
  <button type="button" class="lb-close" id="lbClose" aria-label="Close photo">&times;</button>
  <button type="button" class="lb-prev" id="lbPrev" aria-label="Previous photo">&larr;</button>
  <img class="lb-img" id="lbImg" src="" alt="" />
  <button type="button" class="lb-next" id="lbNext" aria-label="Next photo">&rarr;</button>
  <div class="lb-caption" id="lbCaption"></div>
</div>

<div class="video-lightbox" id="videoLightbox" aria-hidden="true">
  <button type="button" class="video-lightbox-close" id="videoLightboxClose" aria-label="Close video">&times;</button>
  <div class="video-lightbox-window" id="videoLightboxWindow"></div>
</div>
