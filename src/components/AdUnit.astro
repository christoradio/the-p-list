---
interface Props {
  slot: string;
  format?: string;
  className?: string;
}
const { slot, format = "auto", className = "" } = Astro.props;
---
<div class={`ad-unit ${className}`.trim()}>
  <span class="ad-unit-label">Advertisement</span>
  <ins
    class="adsbygoogle"
    style="display:block"
    data-ad-client="ca-pub-3899115269711771"
    data-ad-slot={slot}
    data-ad-format={format}
    data-full-width-responsive="true"
  ></ins>
</div>
<script is:inline>
  (adsbygoogle = window.adsbygoogle || []).push({});
</script>

<style>
  .ad-unit {
    margin: 28px auto;
    max-width: 728px;
    text-align: center;
  }
  .ad-unit-label {
    display: block;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
    opacity: 0.6;
    margin-bottom: 6px;
  }
  /* collapse the slot entirely when Google has no ad to show, instead of
     leaving a blank reserved box (unfilled happens with new/low-traffic
     slots, ad blockers, and sometimes just low advertiser demand) */
  .ad-unit:has(ins[data-ad-status="unfilled"]) {
    display: none;
  }
</style>
