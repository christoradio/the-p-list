---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import AdUnit from "../components/AdUnit.astro";
import Tags from "../components/Tags.astro";
import StatusBadge from "../components/StatusBadge.astro";
import NewsletterBand from "../components/NewsletterBand.astro";
import PostStrip from "../components/PostStrip.astro";
import CategoryTabs from "../components/CategoryTabs.astro";
import {
  sortedByOrder,
  cardMediaSrc,
  cardTeaser,
  locationLabel,
  BEST_OF_SLUGS,
} from "../lib/utils";

const allPosts = sortedByOrder(await getCollection("posts"));
const hero = allPosts[0];
const rest = allPosts.slice(1);
const bestOf = BEST_OF_SLUGS
  .map((slug) => allPosts.find((p) => p.data.slug === slug))
  .filter((p) => p !== undefined);

const heroSrc = hero ? cardMediaSrc(hero) : undefined;

const hasIntl = allPosts.some((p) => p.data.country);

const states = ["NSW", "VIC", "QLD", "WA", "SA", "TAS", "NT", "ACT"].filter((s) =>
  allPosts.some((p) => p.data.state === s && !p.data.country)
);

// Each chunk is 1 wide featured card + this many normal cards. Since the
// grid is 3 columns, this needs to be a multiple of 3 so the normal cards
// fill even rows instead of leaving a dangling row of 1 or 2.
const chunkSize = 7;
---
<BaseLayout path="/">
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <h1 data-reveal style="transition-delay:70ms">Properties that<br />didn't make the<br /><span>A</span>-list<span style="color:var(--rust)">.</span></h1>
      <p class="tagline" data-reveal style="transition-delay:140ms">But should have.</p>
    </div>

    <CategoryTabs posts={allPosts} active="all" />
  </section>

  <section class="listings-section">
    <div class="wrap">
      <div class="listings-header" data-reveal>
        <span class="listings-count" id="listingsCount">Showing {allPosts.length} properties</span>
        <div class="listings-controls">
        <select class="sort-select" id="stateSelect" aria-label="Filter by state">
          <option value="all">All states</option>
          {states.map((s) => <option value={s}>{s}</option>)}
          {hasIntl && <option value="international">Overseas</option>}
        </select>
        <select class="sort-select" id="sortSelect" aria-label="Sort listings">
          <option value="newest">Newest first</option>
          <option value="quirk">Quirk rating</option>
          <option value="beds-desc">Most bedrooms</option>
        </select>
        </div>
      </div>

      {hero && (
        <a
          class="hero-listing"
          href={`/post/${hero.data.slug}`}
          data-reveal
          data-tags={hero.data.tags.join("|")}
          data-status={hero.data.status ?? ""}
          data-state={hero.data.state ?? ""}
          data-country={hero.data.country ?? ""}
        >
          <div class="hero-listing-media">
            {heroSrc ? <img src={heroSrc} alt={hero.data.title} loading="lazy" /> : <div class="ph-placeholder">Photo coming soon</div>}
            {hero.data.youtubeId && (
              <div class="play-badge" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
              </div>
            )}
            <StatusBadge status={hero.data.status} />
          </div>
          <div class="hero-listing-body">
            <div class="hero-listing-eyebrow">&#9733; Featured listing</div>
            <Tags tags={hero.data.tags} />
            <h2>{hero.data.title}</h2>
            <div class="place">{locationLabel(hero)}</div>
            <div class="specs">
              <span>{hero.data.beds} bed</span>
              <span>{hero.data.baths} bath</span>
              <span>{hero.data.cars} car</span>
              <span>{hero.data.era}</span>
            </div>
            <p class="verdict-text">{cardTeaser(hero)}</p>
            <div class="read-more">Read the full file &rarr;</div>
          </div>
        </a>
      )}

      <PostStrip
        id="bestOf"
        posts={bestOf}
        ranked
        eyebrow="Greatest hits"
        heading="The Ones You Lot Can't Stop Gawking At"
        sub="Ranked by sheer volume of people who should have been working."
      />

      <div class="grid" id="postGrid">
        {rest.map((post, i) => {
          const isBreakAnchor = i % chunkSize === 0;
          const nodes = [];
          if (i > 0 && i % chunkSize === 0) {
            nodes.push(<AdUnit slot="3173466971" className="grid-ad" />);
          }
          nodes.push(<PostCard post={post} index={i} wide={isBreakAnchor} />);
          return nodes;
        })}
      </div>
      <p id="noMatch" style="display:none;font-family:var(--mono);font-size:13px;color:var(--ink-soft);text-transform:uppercase;letter-spacing:0.06em;text-align:center;padding:60px 0;">No properties match this filter — try another one.</p>
    </div>
  </section>

  <div class="wrap ad-banner-wrap">
    <a href="https://amzn.asia/d/0iG0b5iB" target="_blank" rel="noopener sponsored" class="home-ad-banner" aria-label="Advertisement">
      <img src="https://images.theplist.com.au/amazon-banner.png" alt="Advertisement" loading="lazy" />
      <span class="ad-label" style="display:block;text-align:center;margin-top:6px;">Advertisement</span>
    </a>
  </div>

  <NewsletterBand />
</BaseLayout>
