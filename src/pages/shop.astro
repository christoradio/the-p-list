---
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsletterBand from "../components/NewsletterBand.astro";
import { SHOP_ITEMS } from "../data/shop";
---
<BaseLayout
  title="The P-Shop — Quirky Home Decor Inspired By The List | The P List"
  description="Mid-century lamps, groovy mirrors and other daggy-glorious finds inspired by the houses on The P List."
  path="/shop"
>
  <div class="wrap shop-hero">
    <span class="eyebrow" data-reveal>The P-Shop</span>
    <h1 data-reveal style="transition-delay:60ms">Things from the houses.<br />For your house.</h1>
    <p class="shop-intro" data-reveal style="transition-delay:120ms">A curated selection of items inspired by (and occasionally spotted in) the properties on The P List. Some are practical. Some are bold statements. All come with our mild endorsement and an Amazon affiliate link, which means we earn a small commission if you buy &mdash; at no extra cost to you, and it doesn't change our opinion of the house.</p>
  </div>

  <div class="wrap shop-grid">
    {SHOP_ITEMS.map((item, i) => (
      <div class="shop-card" data-reveal style={`transition-delay:${i * 80}ms`}>
        {item.image ? (
          <img class="shop-img" src={item.image} alt={item.name} loading="lazy" />
        ) : (
          <div style="font-size:52px;padding:28px 24px 12px;background:linear-gradient(135deg,var(--paper-soft),var(--paper));border-bottom:1px solid var(--line);line-height:1;" aria-hidden="true">{item.emoji}</div>
        )}
        <div class="shop-body">
          <div class="shop-tag eyebrow">{item.tag}</div>
          <h3 class="shop-name">{item.name}</h3>
          <div class="shop-author">{item.author}</div>
          <p class="shop-blurb">{item.blurb}</p>
          {item.connectedTo && (
            <div class="shop-link-ref">Spotted in: <a href={`/post/${item.connectedTo.slug}`}>{item.connectedTo.title} &rarr;</a></div>
          )}
          <a href={item.url} target="_blank" rel="noopener sponsored" class="btn btn-solid shop-btn">Buy it, go on &rarr;</a>
        </div>
      </div>
    ))}
  </div>

  <div class="wrap shop-disclaimer" data-reveal>
    <p>Affiliate disclosure: some links on this page are Amazon affiliate links. If you click through and buy something, The P List earns a small commission. It doesn't change the price for you, and it doesn't change our editorial decisions. We'd cover the house with the outdoor bath regardless.</p>
  </div>

  <NewsletterBand />
</BaseLayout>
